{
  "name": "lucode",
  "displayName": "Lucode",
  "description": "Syntax highlighting and live error checking for the Lucode programming language",
  "version": "0.3.0",
  "icon": "icon.png",
  "publisher": "somore100",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/somore100/lucode"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lucode",
        "aliases": [
          "Lucode",
          "lucode"
        ],
        "extensions": [
          ".luc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lucode",
        "scopeName": "source.lucode",
        "path": "./syntaxes/lucode.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Lucode",
      "properties": {
        "lucode.path": {
          "type": "string",
          "default": "lucode",
          "description": "Path to the lucode program (used for error checking while you type)."
        }
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:lucode"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
